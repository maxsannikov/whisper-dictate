def get_gpu_memory_info_tray():
    """Get GPU memory info, returns dict or None if unavailable."""
    try:
        import subprocess
        result = subprocess.run(
            ["nvidia-smi", "--query-gpu=memory.total,memory.free", "--format=csv,nounits,noheader"],
            capture_output=True,
            text=True,
            timeout=5
        )
        if result.returncode == 0:
            parts = result.stdout.strip().split(",")
            total_mb = int(parts[0].strip())
            free_mb = int(parts[1].strip())
            return {
                "total_gb": round(total_mb / 1024, 1),
                "free_gb": round(free_mb / 1024, 1),
                "used_gb": round((total_mb - free_mb) / 1024, 1)
            }
    except Exception:
        pass
    return None

